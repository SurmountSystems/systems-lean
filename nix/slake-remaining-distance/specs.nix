    ''bounded "else (id, r0) :: setRemain tokenId r rest"''
    ''bounded "if b.id == tokenId then some b.grade else lookupGrade tokenId rest"''
    ''bounded "| UseTerm.lam id g body =>"''
    ''bounded "| UseTerm.app fn arg =>"''
    ''bounded "| UseTerm.letBind id g value body =>"''
    ''bounded "| UseTerm.matchCase id g disc branch =>"''
    ''bounded "| UseTerm.mutualBind idL gL idR gR left right =>"''
    ''bounded "| UseTerm.theoremBody id g ty proof =>"''
    ''bounded "| UseTerm.var id =>"''
  ];
}
