  IO.println s!"== {stageId}: freestanding product path perform dual-equality WRITE CAPABLE-GAP (B37) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteCapableGapMeasured: {productPathFreestandingPerformDualEqualityWriteCapableGapMeasured} ({dualEqualityWriteCapableGapId})"
  IO.println "  CAPABLE-GAP closed with real Capable dual-equality WRITE evidence:"
  IO.println s!"    gap closed: {productPathDualEqualityWriteCapableGapClosed} ({dualEqualityWriteCapableGapClosedId})"
  IO.println s!"    Capable dual-eq live: {productPathCapableWriteDualEqualityLive} ({dualEqualityWriteCapableGapDualEqLiveId})"
  IO.println s!"    step advanced: {productPathDualEqualityWriteCapableGapStepAdvanced} ({dualEqualityWriteCapableGapStepAdvancedId})"
  IO.println s!"    close-path step: {closeStepCapableGap}"
  IO.println s!"    next close-path step still open: {closeStepRetireOfficial}"
  IO.println s!"    Capable WRITE API: {capableWriteApi}"
  IO.println s!"    Capable WRITE module: {capableWriteModule}"
  IO.println s!"    gate: {dualEqualityGateId} / {dualEqualityApiName}"
  IO.println "  dual-equality WRITE parity gap closed (Capable WRITE is dual-equality):"
  IO.println s!"    gap open: {productPathDualEqualityWriteParityGapOpen} (false = closed)"
  IO.println s!"    Capable structural not dual-equality: {productPathCapableWriteStructuralNotDualEquality} (false = dual-eq)"
  IO.println "  dual-equality still blocks official retirement (CAPABLE-GAP != retire FreestandingEmit):"
  IO.println s!"    blocks: {productPathOfficialPathDualEqualityBlocksRetirement}"
  IO.println "  official product path still Lake FreestandingEmit (not perform claimed):"
  IO.println s!"    recipe: {officialPathRecipe}"
  IO.println s!"    Lake writer: {officialPathLakeWriter}"
  IO.println s!"    Lake exe: {officialPathLakeExe}"
  IO.println s!"    still FreestandingEmit: {productPathOfficialPathStillUsesFreestandingEmit}"
  IO.println s!"    still Lake: {productPathOfficialPathStillUsesLake}"
  IO.println s!"    retire FreestandingEmit required: {productPathOfficialPathRetireFreestandingEmitRequired}"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteApiMeasured: {productPathFreestandingPerformDualEqualityWriteApiMeasured} (B36 remains)"
  IO.println s!"  productPathFreestandingPerformClaimed: {productPathFreestandingPerformClaimed} (stays false)"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake}"
  IO.println s!"  Full-bar req still open: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  Lake-free CAPABLE-GAP recipe: just {lakeFreeCapableGapRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println s!"  B36 API recipe: just {b36ApiRecipe}"
  IO.println "  honest: CAPABLE-GAP closed with Capable dual-eq WRITE != perform claimed"
  IO.println "  honest: do not forge productPathFreestandingPerformClaimed true without official path retirement"
  IO.println "  honest: do not forge justfile switch of just build as dual-equality retirement without retire step"
  IO.println "  honest: official path must retire FreestandingEmit with dual-equality before perform claimed"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B36 API rebrand"
  IO.println "  not B6..B36 theater (B37 is CAPABLE-GAP close under perform framing)"
  if productPathFreestandingPerformDualEqualityWriteCapableGapOk then
    IO.println s!"GREEN {stageId}: dual-equality WRITE CAPABLE-GAP surface ok (measured true; gap closed; dual-eq live; step advanced; gap open false; perform claimed false; DependsOnLake true; dual-equality blocks; Full false)"
  else
    IO.eprintln s!"error: {stageId} dual-equality WRITE CAPABLE-GAP surface not ok"
    throw (IO.userError "productPathFreestandingPerformDualEqualityWriteCapableGapOk false")

/-- CAPABLE-GAP PartialReady fold (closed B37). Historical readiness bulk for
    freestanding perform dual-equality WRITE CAPABLE-GAP. SelfApplyFs living tip
    re-exports a chain fold that includes this def for greppable dual-pin + B36
    API PartialReady. Land-time module pins: perform claimed false; StillUses
    FreestandingEmit true; dual-equality blocks true; Full long-name false
    (living tip allows perform / ownership / stepContractFull / complete true
    and StillUses false after later cliffs). Does not flip residual free /
    llvm / PROVABLY.
    Greppable: productPathFreestandingPerformDualEqualityWriteCapableGapPartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-DUAL-EQUALITY-WRITE-CAPABLE-GAP,
    FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-CAPABLE-GAP. -/
def productPathFreestandingPerformDualEqualityWriteCapableGapPartialReady : Bool :=
  productPathFreestandingPerformDualEqualityWriteCapableGapOk
    && productPathFreestandingPerformDualEqualityWriteCapableGapMeasured
    && productPathDualEqualityWriteCapableGapClosed
    && productPathCapableWriteDualEqualityLive
    && productPathDualEqualityWriteCapableGapStepAdvanced
    && !productPathDualEqualityWriteParityGapOpen
    && !productPathCapableWriteStructuralNotDualEquality
    && productPathOfficialPathDualEqualityBlocksRetirement
    && !productPathFreestandingPerformClaimed
    && productPathPerformDependsOnLake
    && productPathOfficialPathStillUsesFreestandingEmit
    && productPathOfficialPathStillUsesLake
    && productPathOfficialPathRetireFreestandingEmitRequired
    && !productPathFreestandingCapableStepContractFullSatisfied

/-- CLI: print CAPABLE-GAP measure. Fail-closed if Ok false. -/
def main (_args : List String) : IO UInt32 := do
  try
    printDualEqualityWriteCapableGapMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

