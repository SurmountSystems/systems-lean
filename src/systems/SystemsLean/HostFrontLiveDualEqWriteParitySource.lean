  "slake-freestanding-perform-dual-equality-write-parity"

/-- B33 official-path alternate recipe (prerequisite). -/
def b33AlternateRecipe : String := "freestanding-perform-official-path-alternate"

/-- Dual-equality WRITE parity surface ok: parity measured; gap open; Capable
    structural not dual-equality; perform claimed false; DependsOnLake true;
    still FreestandingEmit + Lake; retire required; dual-equality blocks;
    B33 alternate measured; Full false. Greppable:
    productPathFreestandingPerformDualEqualityWriteParityOk. -/
def productPathFreestandingPerformDualEqualityWriteParityOk : Bool :=
  (stageId
      == "SLAKE_SELF_HOST_PRODUCT_PATH_PERFORM_DUAL_EQUALITY_WRITE_PARITY_V0")
    && (hostId
        == "HOST-SELF-HOST-PRODUCT-PATH-PERFORM-DUAL-EQUALITY-WRITE-PARITY")
    && (selfHostId
        == "SELF-HOST-PRODUCT-PATH-PERFORM-DUAL-EQUALITY-WRITE-PARITY")
    && (productPathFreestandingPerformDualEqualityWriteParityMeasured == true)
    && (productPathDualEqualityWriteParityGapOpen == true)
    && (productPathCapableWriteStructuralNotDualEquality == true)
    && (productPathFreestandingPerformClaimed == false)
    && (productPathPerformDependsOnLake == true)
    && (productPathFreestandingPerformOfficialPathAlternateMeasured == true)
    && (productPathOfficialPathStillUsesFreestandingEmit == true)
    && (productPathOfficialPathStillUsesLake == true)
    && (productPathOfficialPathRetireFreestandingEmitRequired == true)
    && (productPathOfficialPathDualEqualityBlocksRetirement == true)
    && (productPathFreestandingCapableStepContractFullSatisfied == false)
    && (dualEqualityWriteParityId
        == "FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-PARITY")
    && (dualEqualityWriteParityGapOpenId
        == "FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-PARITY-GAP-OPEN")
    && (dualEqualityWriteParityCapableStructuralId
        == "FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-PARITY-CAPABLE-STRUCTURAL")
    && (dualEqualityWriteParityOfficialEmitId
        == "FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-PARITY-OFFICIAL-EMIT")
    && (dualEqualityBlocksRetirementId
        == "FREESTANDING-PERFORM-OFFICIAL-PATH-DUAL-EQUALITY-BLOCKS-RETIREMENT")
    && (fullBarReqPerformClaimedWithEvidence
        == "FULL-BAR-REQ-PERFORM-CLAIMED-WITH-EVIDENCE")
    && (officialPathRecipe == "build")
    && (officialPathLakeWriter == "FreestandingEmit")
    && (officialPathLakeExe == "slake-emit-freestanding-c")
    && (officialPathDualEqualityGate == "DUAL-SSOT-EQUALITY")
    && (officialPathDualEqualityApi == "requireDualSsotEqual")
    && (capableWriteApi == "freestandingCapableWriteFreestandingHc")
    && (capableWriteModule == "CapableWriteHc")
    && (lakeFreeParityRecipe
        == "freestanding-perform-dual-equality-write-parity")
    && (justMeasureRecipe
        == "freestanding-perform-dual-equality-write-parity-measure")
    && (lakeExeName
        == "slake-freestanding-perform-dual-equality-write-parity")
    && (b33AlternateRecipe == "freestanding-perform-official-path-alternate")

/-- Print dual-equality WRITE parity measure (diagnostic; not perform claimed). -/
def printDualEqualityWriteParityMeasure : IO Unit := do
  IO.println s!"== {stageId}: freestanding product path perform dual-equality WRITE parity (B34) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteParityMeasured: {productPathFreestandingPerformDualEqualityWriteParityMeasured} ({dualEqualityWriteParityId})"
  IO.println "  parity gap (Capable WRITE structural embed != FreestandingEmit dual-equality):"
  IO.println s!"    gap open: {productPathDualEqualityWriteParityGapOpen} ({dualEqualityWriteParityGapOpenId})"
  IO.println s!"    Capable structural not dual-equality: {productPathCapableWriteStructuralNotDualEquality} ({dualEqualityWriteParityCapableStructuralId})"
  IO.println s!"    Capable WRITE API: {capableWriteApi}"
  IO.println s!"    Capable WRITE module: {capableWriteModule}"
  IO.println s!"    official dual-equality gate: {officialPathDualEqualityGate}"
  IO.println s!"    official dual-equality API: {officialPathDualEqualityApi}"
  IO.println s!"    official emit side: {dualEqualityWriteParityOfficialEmitId}"
  IO.println "  dual-equality still blocks retirement (B33 blocker remains):"
  IO.println s!"    blocks: {productPathOfficialPathDualEqualityBlocksRetirement} ({dualEqualityBlocksRetirementId})"
  IO.println "  official product path still Lake FreestandingEmit (not perform claimed):"
  IO.println s!"    recipe: {officialPathRecipe}"
  IO.println s!"    Lake writer: {officialPathLakeWriter}"
  IO.println s!"    Lake exe: {officialPathLakeExe}"
  IO.println s!"    still FreestandingEmit: {productPathOfficialPathStillUsesFreestandingEmit}"
  IO.println s!"    still Lake: {productPathOfficialPathStillUsesLake}"
  IO.println s!"    retire FreestandingEmit required: {productPathOfficialPathRetireFreestandingEmitRequired}"
  IO.println s!"  productPathFreestandingPerformOfficialPathAlternateMeasured: {productPathFreestandingPerformOfficialPathAlternateMeasured} (B33 remains)"
  IO.println s!"  productPathFreestandingPerformClaimed: {productPathFreestandingPerformClaimed} (stays false)"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake}"
  IO.println s!"  Full-bar req still open: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  Lake-free parity recipe: just {lakeFreeParityRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println s!"  B33 alternate recipe: just {b33AlternateRecipe}"
  IO.println "  honest: parity gap measured != dual-equality closed"
  IO.println "  honest: structural Capable WRITE != DUAL-SSOT-EQUALITY Mult..Body"
  IO.println "  honest: do not forge justfile switch of just build to Capable WRITE as dual-equality retirement"
  IO.println "  honest: official path must retire FreestandingEmit with dual-equality before perform claimed"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B33 alternate rebrand"
  IO.println "  not B6..B33 theater (B34 is new dual-equality WRITE parity under perform framing)"
  if productPathFreestandingPerformDualEqualityWriteParityOk then
    IO.println s!"GREEN {stageId}: dual-equality WRITE parity surface ok (parity measured true; gap open true; perform claimed false; DependsOnLake true; dual-equality blocks; Full false)"
  else
    IO.eprintln s!"error: {stageId} dual-equality WRITE parity surface not ok"
    throw (IO.userError "productPathFreestandingPerformDualEqualityWriteParityOk false")

/-- Dual-equality WRITE parity PartialReady fold (closed B34). SelfApplyFs tip
    re-exports chain fold. Land-time: gap open true; Capable structural not
    dual-equality true; perform claimed false; StillUses FreestandingEmit true;
    dual-equality blocks true; Full long-name false. Does not flip residual free /
    llvm / PROVABLY.
    Greppable: productPathFreestandingPerformDualEqualityWriteParityPartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-DUAL-EQUALITY-WRITE-PARITY,
    FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-PARITY. -/
def productPathFreestandingPerformDualEqualityWriteParityPartialReady : Bool :=
  productPathFreestandingPerformDualEqualityWriteParityOk
    && productPathFreestandingPerformDualEqualityWriteParityMeasured
    && productPathDualEqualityWriteParityGapOpen
    && productPathCapableWriteStructuralNotDualEquality
    && productPathOfficialPathDualEqualityBlocksRetirement
    && !productPathFreestandingPerformClaimed
    && productPathPerformDependsOnLake
    && productPathOfficialPathStillUsesFreestandingEmit
    && productPathOfficialPathStillUsesLake
    && productPathOfficialPathRetireFreestandingEmitRequired
    && !productPathFreestandingCapableStepContractFullSatisfied

/-- CLI: print dual-equality WRITE parity measure. Fail-closed if Ok false. -/
def main (_args : List String) : IO UInt32 := do
  try
    printDualEqualityWriteParityMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

end SystemsLean.DualEqWriteParity

