/-- Print PERFORM-CLAIMED measure (diagnostic; not ownership claimed). -/
def printPerformClaimedMeasure : IO Unit := do
  IO.println s!"== {stageId}: freestanding product path perform claimed (B39) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformClaimedMeasured: {productPathFreestandingPerformClaimedMeasured} ({performClaimedId})"
  IO.println "  PERFORM-CLAIMED with real official freestanding dual-equality WRITE evidence:"
  IO.println s!"    step advanced: {productPathFreestandingPerformClaimedStepAdvanced} ({performClaimedStepAdvancedId})"
  IO.println s!"    perform claimed: {productPathFreestandingPerformClaimed} ({performClaimedWithOfficialDualEqWriteId})"
  IO.println s!"    uses dual-eq WRITE: {productPathOfficialPathUsesDualEqualityWrite}"
  IO.println s!"    close-path step: {closeStepPerformClaimed}"
  IO.println s!"    prior RETIRE-OFFICIAL: {closeStepRetireOfficial} (closed B38)"
  IO.println s!"    prior CAPABLE-GAP: {closeStepCapableGap} (closed B37)"
  IO.println s!"    Capable WRITE API: {capableWriteApi}"
  IO.println s!"    Capable WRITE module: {capableWriteModule}"
  IO.println s!"    gate: {dualEqualityGateId} / {dualEqualityApiName}"
  IO.println "  official product path freestanding dual-eq writer (FreestandingEmit retired B38):"
  IO.println s!"    recipe: {officialPathRecipe}"
  IO.println s!"    writer: {officialPathWriter}"
  IO.println s!"    Lake exe: {officialPathLakeExe}"
  IO.println s!"    just recipe: {officialPathJustRecipe}"
  IO.println s!"    still FreestandingEmit: {productPathOfficialPathStillUsesFreestandingEmit} (false = retired)"
  IO.println s!"    still Lake: {productPathOfficialPathStillUsesLake}"
  IO.println s!"    retire FreestandingEmit required: {productPathOfficialPathRetireFreestandingEmitRequired} (false = retired)"
  IO.println s!"    dual-equality blocks retirement: {productPathOfficialPathDualEqualityBlocksRetirement} (false = not blocked)"
  IO.println s!"  productPathOfficialPathRetireOfficialMeasured: {productPathOfficialPathRetireOfficialMeasured} (B38 remains)"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteCapableGapMeasured: {productPathFreestandingPerformDualEqualityWriteCapableGapMeasured} (B37 remains)"
  IO.println s!"  productPathDualEqualityWriteParityGapOpen: {productPathDualEqualityWriteParityGapOpen} (false = CAPABLE-GAP closed)"
  IO.println s!"  productPathCapableWriteDualEqualityLive: {productPathCapableWriteDualEqualityLive}"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake}"
  IO.println s!"  Full-bar req closed with evidence: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  productPathFreestandingOwnershipClaimed: {productPathFreestandingOwnershipClaimed} (stays false; ownership next)"
  IO.println s!"  freestandingProductSelfHostComplete: {freestandingProductSelfHostComplete}"
  IO.println s!"  Lake-free PERFORM-CLAIMED recipe: just {lakeFreePerformClaimedRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println s!"  B38 RETIRE-OFFICIAL recipe: just {b38RetireOfficialRecipe}"
  IO.println s!"  B37 CAPABLE-GAP recipe: just {b37CapableGapRecipe}"
  IO.println "  honest: PERFORM-CLAIMED with official dual-eq WRITE evidence != ownership claimed"
  IO.println "  honest: do not forge freestandingProductSelfHostComplete true without full bar"
  IO.println "  honest: CAPABLE-GAP stays closed; free/llvm/PROVABLY stay false; complete stays false"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B38 RETIRE rebrand"
  IO.println "  not B6..B38 theater (B39 is PERFORM-CLAIMED under perform framing)"
  IO.println "  short module name PerformClaimed (not ProductPathFreestandingPerform* kitchen-sink)"
  if productPathFreestandingPerformClaimedOk then
    IO.println s!"GREEN {stageId}: PERFORM-CLAIMED surface ok (measured true; perform claimed true; official dual-eq WRITE; StillUsesFreestandingEmit false; Blocks false; DependsOnLake true; ownership false; Full false; complete false)"
  else
    IO.eprintln s!"error: {stageId} PERFORM-CLAIMED surface not ok"
    throw (IO.userError "productPathFreestandingPerformClaimedOk false")

/-- PERFORM-CLAIMED PartialReady fold (closed B39). Historical readiness bulk for
    freestanding perform PERFORM-CLAIMED. SelfApplyFs living tip re-exports a
    chain fold that includes this def for greppable dual-pin + retire-official
    PartialReady. Land-time module pins: ownership false; Full long-name false;
    complete false (living tip allows ownership / stepContractFull / complete true
    after later cliffs). Does not flip residual free / llvm / PROVABLY.
    Greppable: productPathFreestandingPerformClaimedPartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-CLAIMED,
    FREESTANDING-PERFORM-CLAIMED. -/
def productPathFreestandingPerformClaimedPartialReady : Bool :=
  productPathFreestandingPerformClaimedOk
    && productPathFreestandingPerformClaimedMeasured
    && productPathFreestandingPerformClaimedStepAdvanced
    && productPathFreestandingPerformClaimed
    && productPathOfficialPathUsesDualEqualityWrite
    && !productPathOfficialPathStillUsesFreestandingEmit
    && !productPathOfficialPathStillUsesLake
    && !productPathOfficialPathRetireFreestandingEmitRequired
    && !productPathOfficialPathDualEqualityBlocksRetirement
    && productPathOfficialPathRetireOfficialMeasured
    && productPathFreestandingPerformDualEqualityWriteCapableGapMeasured
    && !productPathPerformDependsOnLake
    && !productPathFreestandingCapableStepContractFullSatisfied
    && !productPathFreestandingOwnershipClaimed
    && !freestandingProductSelfHostComplete

/-- CLI: print PERFORM-CLAIMED measure. Fail-closed if Ok false. -/
def main (_args : List String) : IO UInt32 := do
  try
    printPerformClaimedMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

end SystemsLean.PerformClaimed

