/-- Accepted parse calls HostKernel.kernelCheck. Not a constant true. -/
def kernelCheckLiveHostModuleCheckPackageEnvDialectTailSource (src : String) : Bool :=
  match parseLiveLlvmComposeTextMainSource src with
  | FrontResult.accept m => HostKernel.kernelCheck m
  | FrontResult.reject _ => false

/-- Ready is parse plus kernelCheck of the pinned text. -/
def hostFrontLiveHostModuleCheckPackageEnvDialectTailSourceReady : Bool :=
  liveRel == "HostModuleCheckPackageEnvDialectTail.lean"
    && kernelCheckLiveHostModuleCheckPackageEnvDialectTailSource liveHostModuleCheckPackageEnvDialectTailSource

def runLive (root : System.FilePath) : IO Unit := do
  IO.println s!"liveRel={liveRel}"
  let path := root / "src/systems/SystemsLean" / liveRel
  unless (<- path.pathExists) do
    throw (IO.userError s!"missing {liveRel}")
  let disk <- IO.FS.readFile path
  if disk != liveHostModuleCheckPackageEnvDialectTailSource then
    throw (IO.userError "dual-pin mismatch HostModuleCheckPackageEnvDialectTail.lean")
  let k := kernelCheckLiveHostModuleCheckPackageEnvDialectTailSource disk
  IO.println s!"kernelCheck={k}"
  unless k do
    throw (IO.userError "kernelCheck live HostModuleCheckPackageEnvDialectTail parse false")
  unless hostFrontLiveHostModuleCheckPackageEnvDialectTailSourceReady do
    throw (IO.userError "ready false")

def main (args : List String) : IO UInt32 := do
  let root : System.FilePath :=
    match args with
    | r :: _ => System.FilePath.mk r
    | [] => "."
  try
    runLive root
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

end SystemsLean.HostFrontLiveHostModuleCheckPackageEnvDialectTailSource
