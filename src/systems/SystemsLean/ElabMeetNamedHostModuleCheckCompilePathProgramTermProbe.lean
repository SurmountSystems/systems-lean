    HostModuleCheckSelfHostTerm /
    HostModuleCheckSurfaceMatrixTerm /
    HostModuleCheckSpecProofTerm /
    HostModuleCheckDualResidualTerm /
    HostModuleCheckCompilePathMultTerm /
    HostModuleCheckCompilePathLinearTerm /
    HostModuleCheckCompilePathTypesTerm oleans, plus EmitPlanTerm and
    MultTerm compile deps.
    Isolation: leftover temp good.lean and leftover fake lean_lib
    ElabMeetRichLib stay false; the prior CompilePathTypesTerm walker
    tryCompileNamedHostModuleCheckCompilePathTypesTermSubset still works; this
    walker is not an alias of the CompilePathTypesTerm closed set. Drive is
    good && !bad && isolation.
    Linear skipped. IrGraph skipped as a grow-tip Name. HostCompose skipped.
    Do not plant live HostModuleCheckCompilePathProgramTerm.lean. Do not skip to
    HostModuleCheckCompilePathGraphTerm. -/
def elabMeetRunNamedHostModuleCheckCompilePathProgramTermSubsetProbe : CommandElabM Unit := do
  let liveLake? <- liftIO findLiveLakefilePath
  let liveMult? <- liftIO findLiveMultPath
  let liveThm? <- liftIO findLiveMultTheoremsPath
  let liveHostModuleCheckCompilePathProgramTerm? <-
    liftIO findLiveHostModuleCheckCompilePathProgramTermPath
  let oleanDir <- liftIO IO.FS.createTempDir
  let badDir <- liftIO IO.FS.createTempDir
  let isoDir <- liftIO IO.FS.createTempDir
  let fakeDir <- liftIO IO.FS.createTempDir
  let good <-
    match liveLake? with
    | none => pure false
    | some liveLake =>
      tryCompileNamedHostModuleCheckCompilePathProgramTermSubset liveLake oleanDir
  let badCompiled <-
    match liveHostModuleCheckCompilePathProgramTerm? with
    | none =>
      pure true
    | some liveHostModuleCheckCompilePathProgramTerm => do
      let liveText <- liftIO (IO.FS.readFile liveHostModuleCheckCompilePathProgramTerm)
      let badPath :=
        badDir / "ElabMeetNamedHostModuleCheckCompilePathProgramTermSubsetBad.lean"
      let planted := "\ndef plantedTypeError : Nat := true\n"
      liftIO (IO.FS.writeFile badPath (liveText ++ planted))
      tryCompileAfterHostModuleCheckCompilePathProgramTermDeps
        badPath badDir `ElabMeetNamedHostModuleCheckCompilePathProgramTermSubsetBad
  let liveMultStillOk <-
    match liveMult? with
    | none => pure false
    | some liveMult =>
      tryCompileLiveModule liveMult isoDir
  let thmIsoDir <- liftIO IO.FS.createTempDir
  let liveThmStillOk <-
    match liveThm? with
    | none => pure false
    | some liveThm =>
      tryCompileLiveTheorems liveThm thmIsoDir
  let subsetIsoDir <- liftIO IO.FS.createTempDir
  let priorSubsetStillOk <-
    match liveLake? with
    | none => pure false
    | some liveLake =>
      tryCompileNamedHostModuleCheckCompilePathTypesTermSubset liveLake subsetIsoDir
  let goodIso := isoDir / "good.lean"
  liftIO (IO.FS.writeFile goodIso "def n : Nat := 0")
  let thisOnTempSnippet <-
    tryCompileNamedHostModuleCheckCompilePathProgramTermSubset goodIso isoDir
  let fakeLake := fakeDir / "lakefile.lean"
  liftIO (IO.FS.writeFile fakeLake leftoverFakePackageLakefileText)
  let thisOnFakePackage <-
    tryCompileNamedHostModuleCheckCompilePathProgramTermSubset fakeLake fakeDir
  let notAliasOfCompilePathTypesTerm :=
    namedClosedHostModuleCheckCompilePathProgramTermSubsetNames
      != namedClosedHostModuleCheckCompilePathTypesTermSubsetNames
      && namedClosedHostModuleCheckCompilePathProgramTermCompileOrder
           != namedClosedHostModuleCheckCompilePathTypesTermCompileOrder
      && namedClosedHostModuleCheckCompilePathProgramTermSubsetNames.contains
           "SystemsLean.HostModuleCheckCompilePathProgramTerm"
      && !namedClosedHostModuleCheckCompilePathTypesTermSubsetNames.contains
           "SystemsLean.HostModuleCheckCompilePathProgramTerm"
  let isolation :=
    liveMultStillOk && liveThmStillOk && priorSubsetStillOk
      && !thisOnTempSnippet && !thisOnFakePackage
      && notAliasOfCompilePathTypesTerm
  try
    liftIO (IO.FS.removeDirAll oleanDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll badDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll isoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll thmIsoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll subsetIsoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll fakeDir)
  catch _ =>
    pure ()
  let gStx <- if good then `(true) else `(false)
  let rStx <- if !badCompiled then `(true) else `(false)
  let iStx <- if isolation then `(true) else `(false)
  let dStx <-
    if good && !badCompiled && isolation then
      `(true)
    else
      `(false)
  let gN := mkIdent `elabMeetAcceptsGoodNamedHostModuleCheckCompilePathProgramTermSubset
  let rN := mkIdent `elabMeetRejectsBadNamedHostModuleCheckCompilePathProgramTermSubset
  let iN := mkIdent `elabMeetRejectsOldWalkAsNamedHostModuleCheckCompilePathProgramTermSubset
  let dN := mkIdent `elabMeetDrivesNamedHostModuleCheckCompilePathProgramTermSubset
  elabCommand (<- `(def $gN : Bool := $gStx))
  elabCommand (<- `(def $rN : Bool := $rStx))
  elabCommand (<- `(def $iN : Bool := $iStx))
  elabCommand (<- `(def $dN : Bool := $dStx))

elab "#elabMeetNamedHostModuleCheckCompilePathProgramTermSubsetProbe" : command => do
  if (<- liftIO slakePackageTypecheckWalk) then
    elabMeetPlantNamedSubsetDrive
      `elabMeetAcceptsGoodNamedHostModuleCheckCompilePathProgramTermSubset
      `elabMeetRejectsBadNamedHostModuleCheckCompilePathProgramTermSubset
      `elabMeetRejectsOldWalkAsNamedHostModuleCheckCompilePathProgramTermSubset
      `elabMeetDrivesNamedHostModuleCheckCompilePathProgramTermSubset
  else
    elabMeetRunNamedHostModuleCheckCompilePathProgramTermSubsetProbe

#elabMeetNamedHostModuleCheckCompilePathProgramTermSubsetProbe

example : elabMeetAcceptsGoodNamedHostModuleCheckCompilePathProgramTermSubset = true := rfl
example : elabMeetRejectsBadNamedHostModuleCheckCompilePathProgramTermSubset = true := rfl
example : elabMeetRejectsOldWalkAsNamedHostModuleCheckCompilePathProgramTermSubset = true := rfl
example : elabMeetDrivesNamedHostModuleCheckCompilePathProgramTermSubset = true := rfl

end SystemsLean.ElabMeet
