    && (hostId
        == "HOST-SELF-HOST-PRODUCT-PATH-PERFORM-OFFICIAL-PATH-ALTERNATE")
    && (selfHostId
        == "SELF-HOST-PRODUCT-PATH-PERFORM-OFFICIAL-PATH-ALTERNATE")
    && (productPathFreestandingPerformOfficialPathAlternateMeasured == true)
    && (productPathFreestandingPerformClaimed == false)
    && (productPathPerformDependsOnLake == true)
    && (productPathFreestandingPerformOfficialPathGapMeasured == true)
    && (productPathOfficialPathStillUsesFreestandingEmit == true)
    && (productPathOfficialPathStillUsesLake == true)
    && (productPathOfficialPathRetireFreestandingEmitRequired == true)
    && (productPathOfficialPathAlternateWriterPresent == true)
    && (productPathOfficialPathAlternateNotOfficial == true)
    && (productPathOfficialPathDualEqualityBlocksRetirement == true)
    && (productPathFreestandingCapableStepContractFullSatisfied == false)
    && (officialPathAlternateId
        == "FREESTANDING-PERFORM-OFFICIAL-PATH-ALTERNATE")
    && (officialPathAlternateWriterId
        == "FREESTANDING-PERFORM-OFFICIAL-PATH-ALTERNATE-WRITER")
    && (officialPathAlternateNotOfficialId
        == "FREESTANDING-PERFORM-OFFICIAL-PATH-ALTERNATE-NOT-OFFICIAL")
    && (officialPathDualEqualityBlocksId
        == "FREESTANDING-PERFORM-OFFICIAL-PATH-DUAL-EQUALITY-BLOCKS-RETIREMENT")
    && (fullBarReqPerformClaimedWithEvidence
        == "FULL-BAR-REQ-PERFORM-CLAIMED-WITH-EVIDENCE")
    && (officialPathRecipe == "build")
    && (officialPathLakeWriter == "FreestandingEmit")
    && (officialPathLakeExe == "slake-emit-freestanding-c")
    && (alternateWriterRecipe == "freestanding-capable-regenerate")
    && (alternateWriterApi == "freestandingCapableOrderedRegenerate")
    && (alternateWriterPipeline
        == "FREESTANDING-CAPABLE-ORDERED-REGENERATE-PIPELINE")
    && (alternateWriterModule == "CapableRegenerate")
    && (lakeFreeAlternateRecipe
        == "freestanding-perform-official-path-alternate")
    && (justMeasureRecipe
        == "freestanding-perform-official-path-alternate-measure")
    && (lakeExeName
        == "slake-freestanding-perform-official-path-alternate")
    && (b32OfficialPathRecipe == "freestanding-perform-official-path")

/-- Print official-path alternate measure (diagnostic; not perform claimed). -/
def printOfficialPathAlternateMeasure : IO Unit := do
  IO.println s!"== {stageId}: freestanding product path perform official-path alternate (B33) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformOfficialPathAlternateMeasured: {productPathFreestandingPerformOfficialPathAlternateMeasured} ({officialPathAlternateId})"
  IO.println "  alternate non-FreestandingEmit writer (not official path):"
  IO.println s!"    present: {productPathOfficialPathAlternateWriterPresent} ({officialPathAlternateWriterId})"
  IO.println s!"    recipe: {alternateWriterRecipe}"
  IO.println s!"    API: {alternateWriterApi}"
  IO.println s!"    pipeline: {alternateWriterPipeline}"
  IO.println s!"    module: {alternateWriterModule}"
  IO.println s!"    not official: {productPathOfficialPathAlternateNotOfficial} ({officialPathAlternateNotOfficialId})"
  IO.println "  dual-equality blocks retirement (structural WRITE embed != dual-equality):"
  IO.println s!"    blocks: {productPathOfficialPathDualEqualityBlocksRetirement} ({officialPathDualEqualityBlocksId})"
  IO.println "  official product path still Lake FreestandingEmit (not perform claimed):"
  IO.println s!"    recipe: {officialPathRecipe}"
  IO.println s!"    Lake writer: {officialPathLakeWriter}"
  IO.println s!"    Lake exe: {officialPathLakeExe}"
  IO.println s!"    still FreestandingEmit: {productPathOfficialPathStillUsesFreestandingEmit}"
  IO.println s!"    still Lake: {productPathOfficialPathStillUsesLake}"
  IO.println s!"    retire FreestandingEmit required: {productPathOfficialPathRetireFreestandingEmitRequired}"
  IO.println s!"  productPathFreestandingPerformOfficialPathGapMeasured: {productPathFreestandingPerformOfficialPathGapMeasured} (B32 remains)"
  IO.println s!"  productPathFreestandingPerformClaimed: {productPathFreestandingPerformClaimed} (stays false)"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake}"
  IO.println s!"  Full-bar req still open: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  Lake-free alternate recipe: just {lakeFreeAlternateRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println s!"  B32 gap recipe: just {b32OfficialPathRecipe}"
  IO.println "  honest: alternate present != official path retired"
  IO.println "  honest: dual-equality blocker prevents forged justfile switch to Capable WRITE"
  IO.println "  honest: official path must retire FreestandingEmit with dual-equality before perform claimed"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B32 gap rebrand"
  IO.println "  not B6..B32 theater (B33 is new official-path alternate under perform framing)"
  if productPathFreestandingPerformOfficialPathAlternateOk then
    IO.println s!"GREEN {stageId}: official-path alternate surface ok (alternate measured true; perform claimed false; DependsOnLake true; dual-equality blocks; Full false)"
  else
    IO.eprintln s!"error: {stageId} official-path alternate surface not ok"
    throw (IO.userError "productPathFreestandingPerformOfficialPathAlternateOk false")

/-- Official-path alternate PartialReady fold (closed B33). SelfApplyFs tip
    re-exports chain fold. Land-time: alternate measured true; writer present;
    AlternateNotOfficial true; dual-equality blocks true; perform claimed false;
    StillUses FreestandingEmit true; Full long-name false. Does not flip residual
    free / llvm / PROVABLY.
    Greppable: productPathFreestandingPerformOfficialPathAlternatePartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-OFFICIAL-PATH-ALTERNATE,
    FREESTANDING-PERFORM-OFFICIAL-PATH-ALTERNATE. -/
def productPathFreestandingPerformOfficialPathAlternatePartialReady : Bool :=
  productPathFreestandingPerformOfficialPathAlternateOk
    && productPathFreestandingPerformOfficialPathAlternateMeasured
    && productPathOfficialPathAlternateWriterPresent
    && productPathOfficialPathAlternateNotOfficial
    && productPathOfficialPathDualEqualityBlocksRetirement
    && !productPathFreestandingPerformClaimed
    && productPathPerformDependsOnLake
    && productPathOfficialPathStillUsesFreestandingEmit
    && productPathOfficialPathStillUsesLake
    && productPathOfficialPathRetireFreestandingEmitRequired
    && !productPathFreestandingCapableStepContractFullSatisfied

/-- CLI: print official-path alternate measure. Fail-closed if Ok false. -/
def main (_args : List String) : IO UInt32 := do
  try
    printOfficialPathAlternateMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

