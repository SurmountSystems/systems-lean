    MultTerm compile deps.
    Isolation: leftover temp good.lean and leftover fake lean_lib
    ElabMeetRichLib stay false; the prior FirstSurfaceTerm walker
    tryCompileNamedHostModuleCheckFirstSurfaceTermSubset still works; this
    walker is not an alias of the FirstSurfaceTerm closed set. Drive is
    good && !bad && isolation.
    Linear skipped. IrGraph skipped as a grow-tip Name. HostCompose skipped.
    Do not plant live HostModuleCheckLinearSubsetEmitTerm.lean. Do not skip to
    HostModuleCheckTypesSubsetEmitTerm. -/
def elabMeetRunNamedHostModuleCheckLinearSubsetEmitTermSubsetProbe : CommandElabM Unit := do
  let liveLake? <- liftIO findLiveLakefilePath
  let liveMult? <- liftIO findLiveMultPath
  let liveThm? <- liftIO findLiveMultTheoremsPath
  let liveHostModuleCheckLinearSubsetEmitTerm? <-
    liftIO findLiveHostModuleCheckLinearSubsetEmitTermPath
  let oleanDir <- liftIO IO.FS.createTempDir
  let badDir <- liftIO IO.FS.createTempDir
  let isoDir <- liftIO IO.FS.createTempDir
  let fakeDir <- liftIO IO.FS.createTempDir
  let good <-
    match liveLake? with
    | none => pure false
    | some liveLake =>
      tryCompileNamedHostModuleCheckLinearSubsetEmitTermSubset liveLake oleanDir
  let badCompiled <-
    match liveHostModuleCheckLinearSubsetEmitTerm? with
    | none =>
      pure true
    | some liveHostModuleCheckLinearSubsetEmitTerm => do
      let liveText <- liftIO (IO.FS.readFile liveHostModuleCheckLinearSubsetEmitTerm)
      let badPath :=
        badDir / "ElabMeetNamedHostModuleCheckLinearSubsetEmitTermSubsetBad.lean"
      let planted := "\ndef plantedTypeError : Nat := true\n"
      liftIO (IO.FS.writeFile badPath (liveText ++ planted))
      tryCompileAfterHostModuleCheckLinearSubsetEmitTermDeps
        badPath badDir `ElabMeetNamedHostModuleCheckLinearSubsetEmitTermSubsetBad
  let liveMultStillOk <-
    match liveMult? with
    | none => pure false
    | some liveMult =>
      tryCompileLiveModule liveMult isoDir
  let thmIsoDir <- liftIO IO.FS.createTempDir
  let liveThmStillOk <-
    match liveThm? with
    | none => pure false
    | some liveThm =>
      tryCompileLiveTheorems liveThm thmIsoDir
  let subsetIsoDir <- liftIO IO.FS.createTempDir
  let priorSubsetStillOk <-
    match liveLake? with
    | none => pure false
    | some liveLake =>
      tryCompileNamedHostModuleCheckFirstSurfaceTermSubset liveLake subsetIsoDir
  let goodIso := isoDir / "good.lean"
  liftIO (IO.FS.writeFile goodIso "def n : Nat := 0")
  let thisOnTempSnippet <-
    tryCompileNamedHostModuleCheckLinearSubsetEmitTermSubset goodIso isoDir
  let fakeLake := fakeDir / "lakefile.lean"
  liftIO (IO.FS.writeFile fakeLake leftoverFakePackageLakefileText)
  let thisOnFakePackage <-
    tryCompileNamedHostModuleCheckLinearSubsetEmitTermSubset fakeLake fakeDir
  let notAliasOfFirstSurfaceTerm :=
    namedClosedHostModuleCheckLinearSubsetEmitTermSubsetNames
      != namedClosedHostModuleCheckFirstSurfaceTermSubsetNames
      && namedClosedHostModuleCheckLinearSubsetEmitTermCompileOrder
           != namedClosedHostModuleCheckFirstSurfaceTermCompileOrder
      && namedClosedHostModuleCheckLinearSubsetEmitTermSubsetNames.contains
           "SystemsLean.HostModuleCheckLinearSubsetEmitTerm"
      && !namedClosedHostModuleCheckFirstSurfaceTermSubsetNames.contains
           "SystemsLean.HostModuleCheckLinearSubsetEmitTerm"
  let isolation :=
    liveMultStillOk && liveThmStillOk && priorSubsetStillOk
      && !thisOnTempSnippet && !thisOnFakePackage
      && notAliasOfFirstSurfaceTerm
  try
    liftIO (IO.FS.removeDirAll oleanDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll badDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll isoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll thmIsoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll subsetIsoDir)
  catch _ =>
    pure ()
  try
    liftIO (IO.FS.removeDirAll fakeDir)
  catch _ =>
    pure ()
  let gStx <- if good then `(true) else `(false)
  let rStx <- if !badCompiled then `(true) else `(false)
  let iStx <- if isolation then `(true) else `(false)
  let dStx <-
    if good && !badCompiled && isolation then
      `(true)
    else
      `(false)
  let gN := mkIdent `elabMeetAcceptsGoodNamedHostModuleCheckLinearSubsetEmitTermSubset
  let rN := mkIdent `elabMeetRejectsBadNamedHostModuleCheckLinearSubsetEmitTermSubset
  let iN := mkIdent `elabMeetRejectsOldWalkAsNamedHostModuleCheckLinearSubsetEmitTermSubset
  let dN := mkIdent `elabMeetDrivesNamedHostModuleCheckLinearSubsetEmitTermSubset
  elabCommand (<- `(def $gN : Bool := $gStx))
  elabCommand (<- `(def $rN : Bool := $rStx))
  elabCommand (<- `(def $iN : Bool := $iStx))
  elabCommand (<- `(def $dN : Bool := $dStx))

elab "#elabMeetNamedHostModuleCheckLinearSubsetEmitTermSubsetProbe" : command => do
  if (<- liftIO slakePackageTypecheckWalk) then
    elabMeetPlantNamedSubsetDrive
      `elabMeetAcceptsGoodNamedHostModuleCheckLinearSubsetEmitTermSubset
      `elabMeetRejectsBadNamedHostModuleCheckLinearSubsetEmitTermSubset
      `elabMeetRejectsOldWalkAsNamedHostModuleCheckLinearSubsetEmitTermSubset
      `elabMeetDrivesNamedHostModuleCheckLinearSubsetEmitTermSubset
  else
    elabMeetRunNamedHostModuleCheckLinearSubsetEmitTermSubsetProbe

#elabMeetNamedHostModuleCheckLinearSubsetEmitTermSubsetProbe

example : elabMeetAcceptsGoodNamedHostModuleCheckLinearSubsetEmitTermSubset = true := rfl
example : elabMeetRejectsBadNamedHostModuleCheckLinearSubsetEmitTermSubset = true := rfl
example : elabMeetRejectsOldWalkAsNamedHostModuleCheckLinearSubsetEmitTermSubset = true := rfl
example : elabMeetDrivesNamedHostModuleCheckLinearSubsetEmitTermSubset = true := rfl

end SystemsLean.ElabMeet
