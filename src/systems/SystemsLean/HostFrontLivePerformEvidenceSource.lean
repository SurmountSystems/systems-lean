namespace SystemsLean.PerformEvidence

/-- Greppable primary stage id (partial B31 freestanding perform evidence). -/
def stageId : String :=
  "SLAKE_SELF_HOST_PRODUCT_PATH_PERFORM_EVIDENCE_V0"

/-- Greppable host map id. -/
def hostId : String :=
  "HOST-SELF-HOST-PRODUCT-PATH-PERFORM-EVIDENCE"

/-- Greppable short map id. -/
def selfHostId : String :=
  "SELF-HOST-PRODUCT-PATH-PERFORM-EVIDENCE"

/-- B31 freestanding perform evidence claimed (substrate; not perform claimed).
    just freestanding-perform-evidence: freestanding-capable performers for
    FREESTANDING-PERFORM-GAP-* under perform framing (AuthorityNotEmit + Capable*
    Lake-free + install + ordered pipeline cite). Greppable:
    productPathFreestandingPerformEvidenceClaimed, FREESTANDING-PERFORM-EVIDENCE. -/
def productPathFreestandingPerformEvidenceClaimed : Bool := true

/-- productPathFreestandingPerformClaimed stays false until official product path
    performs ordered regenerate without Lake elaborating FreestandingEmit.
    Evidence substrate (this partial) is not perform claimed. Greppable:
    productPathFreestandingPerformClaimed.
    Dual-pin note: SelfApplyFs is the claim-bool SSoT; this module repeats false for
    module-local Ok / pure Nix scan. Both must stay false until official path
    retires FreestandingEmit (do not flip only one). -/
def productPathFreestandingPerformClaimed : Bool := false

/-- Official product path regenerate still DependsOnLake (FreestandingEmit via
    just build). Greppable: productPathPerformDependsOnLake. -/
def productPathPerformDependsOnLake : Bool := true

/-- Full freestanding-capable step-contract stays unsatisfied. -/
def productPathFreestandingCapableStepContractFullSatisfied : Bool := false

/-- Named perform evidence tokens (closed intermediate pins). -/
def performEvidenceId : String := "FREESTANDING-PERFORM-EVIDENCE"
def performEvidenceReadId : String := "FREESTANDING-PERFORM-EVIDENCE-READ-SSOT"
def performEvidenceComposeId : String := "FREESTANDING-PERFORM-EVIDENCE-COMPOSE"
def performEvidenceWriteHcId : String := "FREESTANDING-PERFORM-EVIDENCE-WRITE-HC"
def performEvidenceInstallId : String := "FREESTANDING-PERFORM-EVIDENCE-INSTALL-OUT"
def performEvidenceOrderedId : String := "FREESTANDING-PERFORM-EVIDENCE-ORDERED"

/-- Full-bar perform claimed requirement (still open; evidence != claimed). -/
def fullBarReqPerformClaimedWithEvidence : String :=
  "FULL-BAR-REQ-PERFORM-CLAIMED-WITH-EVIDENCE"

/-- Named FREESTANDING-PERFORM-GAP-* still open on official product path
    (FreestandingEmit still Lake writer for just build). Evidence
    advances freestanding-capable performers; does not forge gap closed. -/
def gapReadSsot : String := "FREESTANDING-PERFORM-GAP-READ-SSOT"
def gapCompose : String := "FREESTANDING-PERFORM-GAP-COMPOSE"
def gapWriteHc : String := "FREESTANDING-PERFORM-GAP-WRITE-HC"

/-- Freestanding-capable perform API cites (real modules B16..B20). -/
def freestandingCapableReadApi : String := "freestandingCapableReadDualSsot"
def freestandingCapableComposeApi : String := "freestandingCapableComposePlanApplyBody"
def freestandingCapableWriteHcApi : String := "freestandingCapableWriteFreestandingHc"
def freestandingCapableInstallApi : String := "freestandingCapableInstallFreestandingOut"
def freestandingCapableOrderedApi : String := "freestandingCapableOrderedRegenerate"
def orderedPipelineId : String := "FREESTANDING-CAPABLE-ORDERED-REGENERATE-PIPELINE"

/-- Lake-free evidence recipe (B31). Greppable: freestanding-perform-evidence. -/
def lakeFreeEvidenceRecipe : String := "freestanding-perform-evidence"

/-- Diagnostic Lake measure recipe. -/
def justMeasureRecipe : String := "freestanding-perform-evidence-measure"
def lakeExeName : String := "slake-freestanding-perform-evidence"

/-- Shared Lake-free install body (B10). -/
def sharedInstallRecipe : String := "install-freestanding-c-out"

/-- Capable* Lake-free recipes (B26..B28) used as perform evidence depth. -/
def capableReadLakeFreeRecipe : String := "freestanding-capable-read-lake-free"
def capableComposeLakeFreeRecipe : String := "freestanding-capable-compose-lake-free"
def capableWriteHcLakeFreeRecipe : String := "freestanding-capable-write-hc-lake-free"

/-- Evidence surface ok: evidence claimed true; perform claimed false; DependsOnLake
    true; gap tokens still named; freestanding-capable API cites; ordered pipeline;
    Lake-free recipe; Full false. Greppable: productPathFreestandingPerformEvidenceOk. -/
def productPathFreestandingPerformEvidenceOk : Bool :=
  (stageId == "SLAKE_SELF_HOST_PRODUCT_PATH_PERFORM_EVIDENCE_V0")
    && (hostId == "HOST-SELF-HOST-PRODUCT-PATH-PERFORM-EVIDENCE")
    && (selfHostId == "SELF-HOST-PRODUCT-PATH-PERFORM-EVIDENCE")
    && (productPathFreestandingPerformEvidenceClaimed == true)
    && (productPathFreestandingPerformClaimed == false)
    && (productPathPerformDependsOnLake == true)
    && (productPathFreestandingCapableStepContractFullSatisfied == false)
    && (performEvidenceId == "FREESTANDING-PERFORM-EVIDENCE")
    && (performEvidenceReadId == "FREESTANDING-PERFORM-EVIDENCE-READ-SSOT")
    && (performEvidenceComposeId == "FREESTANDING-PERFORM-EVIDENCE-COMPOSE")
    && (performEvidenceWriteHcId == "FREESTANDING-PERFORM-EVIDENCE-WRITE-HC")
    && (performEvidenceInstallId == "FREESTANDING-PERFORM-EVIDENCE-INSTALL-OUT")
    && (performEvidenceOrderedId == "FREESTANDING-PERFORM-EVIDENCE-ORDERED")
    && (fullBarReqPerformClaimedWithEvidence
        == "FULL-BAR-REQ-PERFORM-CLAIMED-WITH-EVIDENCE")
    && (gapReadSsot == "FREESTANDING-PERFORM-GAP-READ-SSOT")
    && (gapCompose == "FREESTANDING-PERFORM-GAP-COMPOSE")
    && (gapWriteHc == "FREESTANDING-PERFORM-GAP-WRITE-HC")
    && (freestandingCapableReadApi == "freestandingCapableReadDualSsot")
    && (freestandingCapableComposeApi
        == "freestandingCapableComposePlanApplyBody")
    && (freestandingCapableWriteHcApi == "freestandingCapableWriteFreestandingHc")
    && (freestandingCapableInstallApi == "freestandingCapableInstallFreestandingOut")
    && (freestandingCapableOrderedApi == "freestandingCapableOrderedRegenerate")
    && (orderedPipelineId == "FREESTANDING-CAPABLE-ORDERED-REGENERATE-PIPELINE")
    && (lakeFreeEvidenceRecipe == "freestanding-perform-evidence")
    && (justMeasureRecipe == "freestanding-perform-evidence-measure")
    && (lakeExeName == "slake-freestanding-perform-evidence")
    && (sharedInstallRecipe == "install-freestanding-c-out")
    && (capableReadLakeFreeRecipe == "freestanding-capable-read-lake-free")
    && (capableComposeLakeFreeRecipe == "freestanding-capable-compose-lake-free")
    && (capableWriteHcLakeFreeRecipe == "freestanding-capable-write-hc-lake-free")

/-- Print freestanding perform evidence measure (diagnostic; not perform claimed). -/
def printPerformEvidenceMeasure : IO Unit := do
  IO.println s!"== {stageId}: freestanding product path perform evidence (B31) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformEvidenceClaimed: {productPathFreestandingPerformEvidenceClaimed} ({performEvidenceId})"
  IO.println "  freestanding-capable perform evidence (perform framing; not ownership authority):"
  IO.println s!"    READ-SSOT: {performEvidenceReadId} API {freestandingCapableReadApi}"
  IO.println s!"      path: just {capableReadLakeFreeRecipe} (CapableRead Lake-free depth; no lake)"
  IO.println s!"    COMPOSE: {performEvidenceComposeId} API {freestandingCapableComposeApi}"
  IO.println s!"      path: just {capableComposeLakeFreeRecipe} (CapableCompose Lake-free depth; no lake)"
  IO.println s!"    WRITE-HC: {performEvidenceWriteHcId} API {freestandingCapableWriteHcApi}"
  IO.println s!"      path: just {capableWriteHcLakeFreeRecipe} (CapableWriteHc Lake-free depth; no lake)"
  IO.println s!"    INSTALL-OUT: {performEvidenceInstallId} API {freestandingCapableInstallApi}"
  IO.println s!"      path: just {sharedInstallRecipe} (B10 Lake-free install)"
  IO.println s!"    ORDERED: {performEvidenceOrderedId} API {freestandingCapableOrderedApi}"
  IO.println s!"      pipeline: {orderedPipelineId}"
  IO.println s!"  productPathFreestandingPerformClaimed: {productPathFreestandingPerformClaimed} (stays false)"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake} (DependsOnLake true; land-time FreestandingEmit official; living tip B38 retired)"
  IO.println s!"  gaps still open on official product path: {gapReadSsot} / {gapCompose} / {gapWriteHc}"
  IO.println s!"  Full-bar req still open: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  Lake-free evidence recipe: just {lakeFreeEvidenceRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println "  honest: freestanding-capable performers are real perform evidence (AuthorityNotEmit)"
  IO.println "  honest: evidence claimed true != perform claimed true (DependsOnLake remains; FreestandingEmit retired B38)"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B30 authority rebrand"
  IO.println "  not B6..B30 theater (B31 is new perform evidence under perform framing)"
  if productPathFreestandingPerformEvidenceOk then
    IO.println s!"GREEN {stageId}: perform evidence surface ok (evidence claimed true; perform claimed false; DependsOnLake true; Full false)"
  else
    IO.eprintln s!"error: {stageId} perform evidence surface not ok"
    throw (IO.userError "productPathFreestandingPerformEvidenceOk false")

/-- Perform evidence PartialReady fold (closed B31). Historical readiness bulk.
    SelfApplyFs tip re-exports chain fold for dual-pin + B30 PartialReady.
    Land-time pins: evidence claimed true; perform claimed false; DependsOnLake
    true; Full long-name false (tip allows later cliffs). No residual free / llvm /
    PROVABLY flip. Greppable: productPathFreestandingPerformEvidencePartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-EVIDENCE, FREESTANDING-PERFORM-EVIDENCE. -/
def productPathFreestandingPerformEvidencePartialReady : Bool :=
  productPathFreestandingPerformEvidenceOk
    && productPathFreestandingPerformEvidenceClaimed
    && !productPathFreestandingPerformClaimed
    && productPathPerformDependsOnLake
    && !productPathFreestandingCapableStepContractFullSatisfied

/-- CLI: print freestanding perform evidence measure. -/
def main (_args : List String) : IO UInt32 := do
  try
    printPerformEvidenceMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

end SystemsLean.PerformEvidence

