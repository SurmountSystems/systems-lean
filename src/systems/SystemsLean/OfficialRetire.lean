namespace SystemsLean.OfficialRetire

/-- Greppable primary stage id (partial B38 official RETIRE-OFFICIAL). -/
def stageId : String :=
  "SLAKE_SELF_HOST_PRODUCT_PATH_PERFORM_RETIRE_OFFICIAL_V0"

/-- Greppable host map id. -/
def hostId : String :=
  "HOST-SELF-HOST-PRODUCT-PATH-PERFORM-RETIRE-OFFICIAL"

/-- Greppable short map id. -/
def selfHostId : String :=
  "SELF-HOST-PRODUCT-PATH-PERFORM-RETIRE-OFFICIAL"

/-- B38 RETIRE-OFFICIAL measured (official path uses freestanding dual-eq WRITE;
    not perform claimed). just freestanding-retire-official dual-pins official
    path switch + SelfApplyFs StillUsesFreestandingEmit false. Greppable:
    productPathOfficialPathRetireOfficialMeasured,
    FREESTANDING-PERFORM-RETIRE-OFFICIAL. -/
