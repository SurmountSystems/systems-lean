  IO.println s!"== {stageId}: freestanding product path perform dual-equality WRITE close path (B35) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteClosePathMeasured: {productPathFreestandingPerformDualEqualityWriteClosePathMeasured} ({dualEqualityWriteClosePathId})"
  IO.println "  close path named (ordered steps; not execution complete):"
  IO.println s!"    named: {productPathDualEqualityWriteClosePathNamed} ({dualEqualityWriteClosePathNamedId})"
  IO.println s!"    not gap closed: {productPathDualEqualityWriteClosePathNotGapClosed} ({dualEqualityWriteClosePathNotGapClosedId})"
  IO.println "  ordered close-path steps (named evidence for later real dual-equality WRITE):"
  IO.println s!"    1. {closeStepDualEqualityApi} -- freestanding dual-equality WRITE API (Emit* fragments + requireDualSsotEqual + write; not FreestandingEmit authority)"
  IO.println s!"    2. {closeStepCapableGap} -- close Capable structural vs dual-equality parity gap"
  IO.println s!"    3. {closeStepRetireOfficial} -- retire FreestandingEmit on official just build"
  IO.println s!"    4. {closeStepPerformClaimed} -- flip perform claimed only with freestanding dual-equality evidence"
  IO.println "  dual-equality WRITE parity gap still open (B34 remains; close path != closed):"
  IO.println s!"    gap open: {productPathDualEqualityWriteParityGapOpen}"
  IO.println s!"    Capable structural not dual-equality: {productPathCapableWriteStructuralNotDualEquality}"
  IO.println s!"    Capable WRITE API: {capableWriteApi}"
  IO.println s!"    Capable WRITE module: {capableWriteModule}"
  IO.println s!"    official dual-equality gate: {officialPathDualEqualityGate}"
  IO.println s!"    official dual-equality API: {officialPathDualEqualityApi}"
  IO.println "  dual-equality still blocks retirement (B33/B34 blocker remains):"
  IO.println s!"    blocks: {productPathOfficialPathDualEqualityBlocksRetirement}"
  IO.println "  official product path still Lake FreestandingEmit (not perform claimed):"
  IO.println s!"    recipe: {officialPathRecipe}"
  IO.println s!"    Lake writer: {officialPathLakeWriter}"
  IO.println s!"    Lake exe: {officialPathLakeExe}"
  IO.println s!"    still FreestandingEmit: {productPathOfficialPathStillUsesFreestandingEmit}"
  IO.println s!"    still Lake: {productPathOfficialPathStillUsesLake}"
  IO.println s!"    retire FreestandingEmit required: {productPathOfficialPathRetireFreestandingEmitRequired}"
  IO.println s!"  productPathFreestandingPerformDualEqualityWriteParityMeasured: {productPathFreestandingPerformDualEqualityWriteParityMeasured} (B34 remains)"
  IO.println s!"  productPathFreestandingPerformClaimed: {productPathFreestandingPerformClaimed} (stays false)"
  IO.println s!"  productPathPerformDependsOnLake: {productPathPerformDependsOnLake}"
  IO.println s!"  Full-bar req still open: {fullBarReqPerformClaimedWithEvidence}"
  IO.println s!"  productPathFreestandingCapableStepContractFullSatisfied: {productPathFreestandingCapableStepContractFullSatisfied}"
  IO.println s!"  Lake-free close-path recipe: just {lakeFreeClosePathRecipe}"
  IO.println s!"  measure: just {justMeasureRecipe} / lake exe {lakeExeName}"
  IO.println s!"  B34 parity recipe: just {b34ParityRecipe}"
  IO.println "  honest: close path named != dual-equality gap closed"
  IO.println "  honest: do not forge productPathDualEqualityWriteParityGapOpen false without real dual-equality freestanding WRITE"
  IO.println "  honest: do not forge justfile switch of just build to Capable WRITE as dual-equality retirement"
  IO.println "  honest: official path must retire FreestandingEmit with dual-equality before perform claimed"
  IO.println "  not ownership claimed; not Full; not complete; not residual free; not B34 parity rebrand"
  IO.println "  not B6..B34 theater (B35 is new dual-equality WRITE close path under perform framing)"
  if productPathFreestandingPerformDualEqualityWriteClosePathOk then
    IO.println s!"GREEN {stageId}: dual-equality WRITE close-path surface ok (close path measured true; named true; not gap closed true; gap open true; perform claimed false; DependsOnLake true; dual-equality blocks; Full false)"
  else
    IO.eprintln s!"error: {stageId} dual-equality WRITE close-path surface not ok"
    throw (IO.userError "productPathFreestandingPerformDualEqualityWriteClosePathOk false")

/-- Dual-equality WRITE close-path PartialReady fold (closed B35). Historical
    readiness bulk for freestanding perform dual-equality WRITE close path.
    SelfApplyFs living tip re-exports a chain fold that includes this def for
    greppable dual-pin + B34 parity PartialReady. Land-time module pins: gap
    open true; Capable structural not dual-equality true; perform claimed false;
    StillUses FreestandingEmit true; dual-equality blocks true; not-gap-closed
    true; Full long-name false (living tip allows perform / ownership /
    stepContractFull / complete true and StillUses false / gap closed after
    later cliffs). Does not flip residual free / llvm / PROVABLY.
    Greppable: productPathFreestandingPerformDualEqualityWriteClosePathPartialReady,
    SELF-HOST-PRODUCT-PATH-PERFORM-DUAL-EQUALITY-WRITE-CLOSE-PATH,
    FREESTANDING-PERFORM-DUAL-EQUALITY-WRITE-CLOSE-PATH. -/
def productPathFreestandingPerformDualEqualityWriteClosePathPartialReady : Bool :=
  productPathFreestandingPerformDualEqualityWriteClosePathOk
    && productPathFreestandingPerformDualEqualityWriteClosePathMeasured
    && productPathDualEqualityWriteClosePathNamed
    && productPathDualEqualityWriteClosePathNotGapClosed
    && productPathDualEqualityWriteParityGapOpen
    && productPathCapableWriteStructuralNotDualEquality
    && productPathOfficialPathDualEqualityBlocksRetirement
    && !productPathFreestandingPerformClaimed
    && productPathPerformDependsOnLake
    && productPathOfficialPathStillUsesFreestandingEmit
    && productPathOfficialPathStillUsesLake
    && productPathOfficialPathRetireFreestandingEmitRequired
    && !productPathFreestandingCapableStepContractFullSatisfied

/-- CLI: print dual-equality WRITE close-path measure. Fail-closed if Ok false. -/
def main (_args : List String) : IO UInt32 := do
  try
    printDualEqualityWriteClosePathMeasure
    pure 0
  catch e =>
    IO.eprintln s!"{e}"
    pure 1

