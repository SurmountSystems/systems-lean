/-- freestandingDualEqualityWriteFreestandingHc -- freestanding dual-equality
    product-path WRITE of freestanding .h/.c under root/src/systems/emit without
    FreestandingEmit as product authority. Loads dual SSOT HEADER/BODY, fails
    closed on DUAL-SSOT-EQUALITY vs Lean Emit* fragments, embeds templates,
    IO.FS.writeFile. Greppable: freestandingDualEqualityWriteFreestandingHc,
    DUAL-SSOT-EQUALITY, requireDualSsotEqual, dualSsotBlockEqual,
    FREESTANDING-DUAL-EQUALITY-WRITE-CLOSE-STEP-DUAL-EQUALITY-API,
    slake_freestanding.h, slake_freestanding.c, IO.FS.writeFile. -/
def freestandingDualEqualityWriteFreestandingHc (root : System.FilePath) : IO Unit := do
  let emitDir := root / "src" / "systems" / "emit"
  let tmplH := emitDir / "template_slake_freestanding.h.in"
  let tmplC := emitDir / "template_slake_freestanding.c.in"
  let outH := emitDir / emitHeaderBase
  let outC := emitDir / emitSourceBase
  IO.println s!"== {stageId}: freestanding dual-equality WRITE-HC freestanding .h/.c (B36) =="
  IO.println s!"  host: {hostId} / {selfHostId}"
  IO.println s!"  close-path step: {closeStepDualEqualityApi} (advanced; CAPABLE-GAP still open)"
  IO.println s!"  API: {freestandingDualEqualityWriteApi}"
  IO.println s!"  gate: {dualEqualityGateId} / {dualEqualityApiName}"
  IO.println s!"  dualSsotEqualityLive: {dualSsotEqualityLive}"
  IO.println "  authority: not FreestandingEmit (no import; Emit* fragments + local requireDualSsotEqual + write)"
  IO.println s!"    productPathDualEqualityWriteApiAuthorityNotEmit: {productPathDualEqualityWriteApiAuthorityNotEmit}"
  IO.println s!"    productPathDualEqualityWriteApiNotOfficial: {productPathDualEqualityWriteApiNotOfficial}"
  IO.println "  depth: dual SSOT HEADER/BODY + DUAL-SSOT-EQUALITY vs Lean Emit* + template embed + IO.FS.writeFile"
  IO.println "  not: FreestandingEmit.emitAtRoot; not official just build; not perform claimed; not gap closed"
  unless dualSsotEqualityLive do
    IO.eprintln s!"error: {dualEqualityGateId}: dualSsotEqualityLive pin false"
    throw (IO.userError s!"{dualEqualityGateId}: live pin")
  let mut loaded : List LoadedDualSsot := []
  for spec in dualEqualityWriteSpecs do
    let path := emitDir / spec.base
    let one <- freestandingDualEqualityWriteLoadOne path spec
    IO.println s!"  dual-eq ok: {path} ({spec.token}; {spec.headerBlock}/{spec.bodyBlock} == Lean fragment)"
    loaded := loaded ++ [one]
  if loaded.isEmpty then
    IO.eprintln "error: no dual SSOT loaded for dual-equality write"
    throw (IO.userError "empty dual-equality write inputs")
  IO.println s!"  {dualEqualityGateId}: Banner + Mult..Body HEADER/BODY match Lean Emit* fragments"
  requireFile tmplH "header template"
  requireFile tmplC "source template"
  let th <- IO.FS.readFile tmplH
  let tc <- IO.FS.readFile tmplC
  if th.isEmpty || tc.isEmpty then
    IO.eprintln "error: empty emit template"
    throw (IO.userError "empty template")
  let bodyDialectPath := emitDir / "host_emit_body_fragment.ssot.txt"
  let dialect <- loadBodySsotDialect bodyDialectPath
  IO.println "  HOST-EMIT-SSOT dialect keys loaded (EMPTY_FRAGMENT + HEADER_*/TAG_*)"
  let header <- assembleHeaderFromSsot th loaded
  let sourceRaw <- assembleSourceFromSsot tc loaded
  let source <- applyBodySsotDialect sourceRaw dialect
  IO.FS.createDirAll emitDir
  IO.FS.writeFile outH header
  IO.FS.writeFile outC source
  let headerWritten <- IO.FS.readFile outH
  let sourceWritten <- IO.FS.readFile outC
  requireFile outH s!"emit header after write ({emitHeaderBase})"
  requireFile outC s!"emit source after write ({emitSourceBase})"
  -- validateProduct-parity post-write (local; not FreestandingEmit.validateProduct).
  -- Toward full parity; still not CAPABLE-GAP / perform claimed / retirement evidence.
  validateDualEqualityWriteProduct outH headerWritten false dialect
  validateDualEqualityWriteProduct outC sourceWritten true dialect
  IO.println s!"GREEN {stageId}: freestanding dual-equality wrote emit wire under {emitDir}/"
  IO.println s!"  wrote: {outH} ({headerWritten.length} chars)"
  IO.println s!"  wrote: {outC} ({sourceWritten.length} chars)"
  IO.println s!"  {closeStepDualEqualityApi} advanced (real dual-equality freestanding WRITE API)"
  IO.println "  post-write: validateDualEqualityWriteProduct (validateProduct token+ban+dialect parity)"
  IO.println s!"  honest: {closeStepCapableGap} still open (parity gap not closed this slice)"
  IO.println "  honest: post-write parity checks are not retirement evidence; gap open / perform claimed stay false"
  IO.println "  honest: land-time API not sole official path; living tip B38 freestanding dual-eq regenerate is official"
  IO.println "  honest: perform claimed false; Full false; complete false; not residual free"
