  ++ "| spent\n"
  ++ "| once\n"
  ++ "| many\n"
  ++ "def remainOfGrade : Remain := Remain.spent\n"
  ++ "def stepRemain : Check := Check.ok\n"
  ++ "def lookupGrade : Option Grade := none\n"
  ++ "def lookupRemain : Option Remain := none\n"
  ++ "def setRemain : List (Prod TokenId Remain) := []\n"
  ++ "def remainBinders : List (Prod TokenId Remain) := []\n"
  ++ "def leftoverRemain : Check := Check.ok\n"
  ++ "def checkTelescopeGo : Check := Check.ok\n"
  ++ "def checkTelescope : Check := Check.ok\n"
  ++ "def checkTelescopeOk : Bool := false\n"
  ++ "theorem checkTelescope_mixed_ok : True := by trivial\n"
  ++ "theorem checkTelescope_spent : True := by trivial\n"
  ++ "theorem checkTelescope_linear_drop : True := by trivial\n"
  ++ "def telescopeUseCheckReady : Bool := false\n"
  ++ "def bindAppend : List TypedBinder := []\n"
  ++ "def useAppend : List TypedUse := []\n"
  ++ "inductive UseTerm where\n"
  ++ "def termBinders : List TypedBinder := []\n"
  ++ "def usesOf : List TypedUse := []\n"
  ++ "def checkTerm : Check := Check.ok\n"
  ++ "def checkTermOk : Bool := false\n"
  ++ "theorem checkTerm_mixed_ok : True := by trivial\n"
  ++ "theorem checkTerm_spent : True := by trivial\n"
  ++ "theorem checkTerm_linear_drop : True := by trivial\n"
  ++ "def termUseCheckReady : Bool := false\n"
  ++ "| var\n"
  ++ "| lam\n"
  ++ "theorem checkTerm_lam_spent : True := by trivial\n"
  ++ "def lamUseCheckReady : Bool := false\n"
  ++ "| app\n"
  ++ "theorem checkTerm_app_spent : True := by trivial\n"
  ++ "def appUseCheckReady : Bool := false\n"
  ++ "| matchCase\n"
  ++ "theorem checkTerm_match_spent : True := by trivial\n"
  ++ "def matchUseCheckReady : Bool := false\n"
  ++ "| mutualBind\n"
  ++ "theorem checkTerm_mutual_spent : True := by trivial\n"
  ++ "def mutualUseCheckReady : Bool := false\n"
  ++ "| theoremBody\n"
  ++ "theorem checkTerm_theorem_spent : True := by trivial\n"
  ++ "def theoremBodyUseCheckReady : Bool := false\n"
  ++ "def allTypesUseCheckDone : Bool := false\n"
  ++ "end SystemsLean.UseCheck\n"

