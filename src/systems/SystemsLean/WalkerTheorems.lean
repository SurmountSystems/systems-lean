  ++ "def checkTypedUseOk : Bool := false\n"
  ++ "def checkBinders : Check := Check.ok\n"
  ++ "def checkBindersOk : Bool := false\n"
  ++ "theorem checkGrade_linear_ok : True := by trivial\n"
  ++ "theorem checkGrade_linear_doubleSpend : True := by trivial\n"
  ++ "theorem checkTypedUse_illegal : True := by trivial\n"
  ++ "theorem checkBinders_mixed_ok : True := by trivial\n"
  ++ "theorem checkBinders_illegal : True := by trivial\n"
  ++ "def typedUseCheckReady : Bool := false\n"
