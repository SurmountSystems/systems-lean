/-
  Module: SystemsLean.WalkerTheorems
  Long-file split from SystemsLean.Walker: let / match /
  mutual / theoremBody / lam / app none-fixtures live here, plus
  typed / telescope / term / consume / share shape fixtures.
  Constructor-omit fixtures also carry def Grade.name, def
  typedGradeUniform, constructor var, Grade constructors
  erased, linear, and share, Check constructors ok, drop, and
  doubleSpend, and Remain constructors spent, once, and many.
  No new constructor.
  parseUseCheck, seesDecls, and useCheckCoreSrc stay in
  Walker.
  Same namespace SystemsLean.Walker so names stay
  unqualified under that namespace.
  Does not call Lean.Elab.processCommands.
  slakeOwnsPackageTypecheck stays false.
  allTypesUseCheckDone stays false.
  No new UseTerm constructor. Split only.
  Module must stay ASCII.
-/

import SystemsLean.Walker

namespace SystemsLean.Walker

def useCheckNoLetSrc : String :=
  useCheckCoreSrc
  ++ "inductive Grade where\n"
  ++ "| erased\n"
  ++ "| linear\n"
  ++ "| share\n"
  ++ "def Grade.name : String := \"MULT-0\"\n"
  ++ "structure TypedUse where\n"
  ++ "structure TypedBinder where\n"
  ++ "def typedCount : Nat := 0\n"
  ++ "def typedGradeUniform : Bool := true\n"
