  "; SLAKE_TRAIT_OBJECT_VTABLE_V0 / HOST-TRAIT-OBJECT-VTABLE\n"
    ++ "; TRAIT-OBJECT-VTABLE-IR named fixture (not FullBackend)\n"
    ++ "; " ++ hostOriginId
